{
  "name": "zo-ai-android",
  "private": true,
  "version": "0.1.0",
  "description": "ZO-AI Android store app: a thin Capacitor wrapper that loads the website.",
  "scripts": {
    "sync": "cap sync android",
    "assets": "node scripts/make-assets.mjs",
    "debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "bundle": "cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-firebase/authentication": "7.5.0",
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.10",
    "@capacitor/keyboard": "7.0.6",
    "@capacitor/push-notifications": "7.0.7",
    "@capacitor/share": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0"
  }
}
