# Maintainer: Zohaib Baig <zohaibbaig144@gmail.com>
# PKGBUILD for zohara-ai. CI (.github/workflows/build.yml) compiles first, copies this file to the repository root and
# runs makepkg, which only packages the finished binaries. Version: _PKGVER from CI, else Cargo's.
pkgname=zohara-ai
pkgver=${_PKGVER:-0.1.0}
pkgrel=1
pkgdesc="ZO-AI: the AI built into Zohara OS, with an MCP server that lets any MCP client control the system"
arch=('x86_64')
url="https://github.com/Zohaib8090/ZO-AI"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'libsecret' 'webkitgtk-6.0')   # libsecret: secret-tool keeps API keys in the system keyring; webkitgtk-6.0: the built-in browser
makedepends=('cargo')
optdepends=('android-tools: control Android devices over adb'
            'waydroid: control Android apps'
            'spectacle: screenshots'
            'claude-code: Claude Code mode (or install it with npm)')

package() {
  cd "$startdir"
  local d=crates/zo-ai/data
  install -Dm755 target/release/zo-ai  "$pkgdir/usr/bin/zo-ai"
  install -Dm755 target/release/zo-mcp "$pkgdir/usr/bin/zo-mcp"
  install -Dm644 $d/org.zohara.ZoAi.desktop    "$pkgdir/usr/share/applications/org.zohara.ZoAi.desktop"
  install -Dm644 $d/zo-ai-quick.desktop      "$pkgdir/usr/share/applications/zo-ai-quick.desktop"
  install -Dm644 $d/zo-ai-background.desktop "$pkgdir/etc/xdg/autostart/zo-ai-background.desktop"
  install -Dm644 $d/org.zohara.ZoAi.metainfo.xml "$pkgdir/usr/share/metainfo/org.zohara.ZoAi.metainfo.xml"
  install -Dm644 $d/zo-ai.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/zo-ai.svg"
}
